      "url": "https://{host}",
      "description": "Anonymously accessible endpoints.",
      "variables": {
        "host": {
          "default": "gerrit-review.googlesource.com"
        }
      }
    },
    {
      "url": "https://{host}/a",
      "description": "Authenticated endpoints (HTTP basic auth).",
      "variables": {
        "host": {
          "default": "gerrit-review.googlesource.com"
        }
      }
    }
  ],
  "securitySchemes": {
    "basicAuth": {
      "type": "http",
      "scheme": "basic",
      "description": "HTTP basic auth with a username and a generated HTTP password."
    }
