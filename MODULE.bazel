"""gerrit_rules_openapi — build-time Bazel ruleset that extracts an OpenAPI 3.1
document from Gerrit's REST bindings (source -> spec).

NOT a Gerrit plugin: nothing here is loaded at runtime. Consumed via bazel_dep
by Gerrit core and by plugins built in-tree or standalone.
"""

module(
    name = "gerrit_rules_openapi",
    version = "1.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")

# The default extractor backend is a program (Python today, Java+Python in the
# real lift). rules_python is a NORMAL dep: a consumer that only packages a
# committed spec via //openapi:defs.bzl never instantiates openapi_spec, so the
# extractor action — and this toolchain — are never built for that consumer.
bazel_dep(name = "rules_python", version = "1.7.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

# Java extractor backend deps. The extractor is parse-only (reads gerrit REST
# source files passed as inputs via the javac com.sun.source API), so it needs
# only gson + guava + the JDK; the single gerrit-internal symbol (@Nullable) is
# vendored under extractor/java/com/google/gerrit/common.
bazel_dep(name = "rules_java", version = "9.9.0")  # match gerrit (JDK 25 toolchains)
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_shell", version = "0.6.1")  # gate-test helpers in the pipeline rule

# Dev-only: Starlark API reference. stardoc renders Markdown from the rule
# docstrings; write_source_files (aspect_bazel_lib) copies it into docs/. Neither
# is pulled into a consumer -- both are dev_dependency.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.google.code.gson:gson:2.14.0",
        "com.google.guava:guava:33.4.8-jre",
    ],
)
use_repo(maven, "maven")

# Register the default (swappable) extractor toolchain. A site or experiment may
# register its own ahead of this one.
register_toolchains("//openapi:default_extractor_toolchain")
